# Rust build output
#
# Unanchored so it also covers the independent tooling workspace at
# tools/target, which a root-anchored `/target` would miss.
target/
/dist/

# Local runtime configuration
/config.toml
/.env

# Secrets
/secrets/
*.key
*.pem

# Packet captures
/captures/
*.pcap
*.pcapng

# Temporary test output
/test-output/
/scripts/__pycache__/
/fuzz/artifacts/
/fuzz/corpus/
/fuzz/coverage/
/benchmarks/rust-reality-matrix.*/
/benchmarks/deployment.*/
/benchmarks/soak.*/
/benchmarks/.asset-cache/
/fuzz/target/
/artifacts/

# Editor files
__pycache__/
*.swp
*.swo
/.idea/
/.vscode/
/scripts/bench-origin/benchmarks/
/benchmarks/profile-validation/
/benchmarks/profile-validation.*/
