{
  "assets": {
    "cacheDirectory": "/var/lib/rust-reality/assets",
    "geoip": "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geoip.dat",
    "geosite": "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geosite.dat",
    "maxBytes": 134217728,
    "reloadIntervalSeconds": 300,
    "requestTimeoutSeconds": 120
  },
  "dns": {
    "cache": {
      "maxEntries": 1024,
      "maxTtlSeconds": 3600,
      "minTtlSeconds": 5,
      "negativeTtlSeconds": 60,
      "staticTtlSeconds": 300,
      "systemReuseMs": 0
    },
    "servers": [
      "system"
    ],
    "timeoutMs": 5000
  },
  "inbounds": [
    {
      "listen": {
        "ipv4": "0.0.0.0",
        "ipv6": "::",
        "mode": "auto"
      },
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "email": "test-user",
            "flow": "xtls-rprx-vision",
            "id": "11111111-1111-4111-8111-111111111111",
            "shortIds": [
              "0123456789abcdef",
              "1023456789abcdef"
            ]
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "realitySettings": {
          "maxTimeDiffMs": 60000,
          "privateKey": "ERERERERERERERERERERERERERERERERERERERERERE",
          "serverNames": [
            "www.example.com"
          ],
          "target": "www.example.com:443"
        },
        "security": "reality"
      },
      "tag": "public-reality"
    }
  ],
  "log": {
    "level": "info",
    "output": "stderr"
  },
  "network": {
    "dial": {
      "fallbackDelayMs": 250,
      "hardFailurePenaltySeconds": 30,
      "latencyMemorySeconds": 300,
      "mode": "auto",
      "routeRefreshSeconds": 30
    }
  },
  "outbounds": [
    {
      "protocol": "direct",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "settings": {
        "responseDelayMs": 0
      },
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "globalRules": [
      {
        "domain": [],
        "inboundTag": [],
        "ip": [
          "geoip:private"
        ],
        "name": "block-private",
        "network": [],
        "outbound": "block",
        "port": []
      }
    ],
    "users": [
      {
        "defaultOutbound": "direct",
        "name": "direct-users",
        "rules": [],
        "userIds": [
          "11111111-1111-4111-8111-111111111111"
        ]
      }
    ]
  }
}
